# secrets — never commit
.env
.env.*
!.env.example
*.pem

# python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
dist/
build/

# node
node_modules/
services/web/dist/
services/web/dev-dist/
.vite/
*.tsbuildinfo

# local data
*.duckdb
*.duckdb.wal
.phoenix/

# Runtime artefacts. The directory is committed (see data/README.md) so the bind mount
# has something to attach to; what lands in it is not.
data/*
!data/.gitkeep
!data/README.md

# ---------------------------------------------------------------------------
# Electricity Maps data. NEVER committed to this repository.
#
# Their terms prohibit reproducing or publishing Data to any third party, and this
# repository is public. Recordings and raw fixtures therefore live in a separate private
# archive mounted at ./recordings. See docs/adr/0013-recorded-data-is-not-published.md
# and ops/README.md.
# ---------------------------------------------------------------------------
/recordings/
/fixtures/

# The two bundled scenarios are generated by `make scenario` -- our own synthetic numbers,
# not Electricity Maps data -- so they stay committed. Everything else in scenarios/ is a
# recording and must not be.
scenarios/*.json
!scenarios/dk2-wind-lull.json
!scenarios/es-solar-surplus.json

# A capability probe run ad hoc rather than through `make probe` lands here.
capabilities.json

# Captured eval transcripts record one run against one scenario. The hand-written
# examples in evals/examples/ are fixtures and are committed; these are not.
evals/transcripts/*.json

# os / editors
.DS_Store
Thumbs.db
.idea/
.vscode/
