# ---------------------------------------------------------------------------
# Grid Lab — local configuration
# Copy to `.env` and fill in. `.env` is gitignored; never commit real tokens.
# ---------------------------------------------------------------------------

# --- Electricity Maps -------------------------------------------------------
# Get a token: https://portal.electricitymaps.com/  (free tier, or 14-day trial)
# NOTE: a 14-day trial started today expires before 11 Sep. Start it 5-8 Sep.
# Leave blank to run entirely in REPLAY mode against committed fixtures.
ELECTRICITY_MAPS_API_TOKEN=

# Base URL. Only change this to point at a mock server.
ELECTRICITY_MAPS_BASE_URL=https://api.electricitymaps.com/v4

# --- Grid Lab runtime -------------------------------------------------------
# live   = call Electricity Maps, cache in DuckDB
# replay = play a recorded scenario against a virtual clock (no network, no key)
GRIDLAB_MODE=replay

# Scenario used when GRIDLAB_MODE=replay. See scenarios/.
#
# Recordings are date-stamped so a daily `make scenario-live` never overwrites yesterday.
# Point this at the newest one you want to replay; if it is missing, the lab falls back to
# whichever scenario sorts first and says so in the log.
GRIDLAB_SCENARIO=dk-dk2-2026-08-22

# Replay speed multiplier (1 = real time, 60 = one minute per second).
GRIDLAB_REPLAY_SPEED=60

# Zones the lab exposes. Trimmed automatically to what your token can reach.
GRIDLAB_ZONES=DK-DK1,DK-DK2,DE,FR,ES,PL,NO-NO2,SE-SE4

GRIDLAB_LOG_LEVEL=INFO
GRIDLAB_DB_PATH=/data/gridlab.duckdb

# --- Agent ------------------------------------------------------------------
ANTHROPIC_API_KEY=
GRIDLAB_AGENT_MODEL=claude-opus-5

# The agent reaches the domain only through this URL. It has no other egress.
GRIDLAB_API_URL=http://api:8000

# --- Optional tracing (docker compose --profile tracing up) -----------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://phoenix:4317
GRIDLAB_TRACING_ENABLED=false
